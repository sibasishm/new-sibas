---
import Layout from '@/layouts/Layout.astro';
---

<Layout>
  <!-- Hero -->
  <section class="max-w-3xl">
    <h1 class="text-balance text-3xl font-bold tracking-tight lg:text-7xl md:text-6xl sm:text-5xl">
      <span class="block font-title italic">everything else</span>
      <span class="mt-1 block text-secondary font-semibold">by Sibasish Mohanty</span>
    </h1>
    <p class="mx-auto mt-4 text-pretty text-sm text-secondary leading-relaxed sm:mx-0 md:mt-8 sm:mt-6 sm:text-lg">
      Welcome to my corner of the internet&ndash;not just pixels and pull requests. This is where I write <span class="text-primary italic">everything else</span> that moves me: ideas, rants, side quests, and half-finished thoughts&ndash;everything I can't put on a résumé.
    </p>
    <div class="mt-6 flex flex-wrap gap-3 md:mt-10 sm:mt-8 sm:justify-start md:gap-6 sm:gap-4">
      <a
        href="/about"
        class="min-h-[44px] inline-flex items-center gap-2 text-sm font-medium"
      >
        <span>More about me</span>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </section>
  <!-- End Hero -->
